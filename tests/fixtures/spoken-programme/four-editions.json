{
  "schema": "reel.spoken-edition.v1",
  "id": "public-engineering-fixture",
  "sample_rate": 48000,
  "modules": [
    {
      "id": "opening",
      "requires": [],
      "cues": [
        {
          "id": "opening",
          "speaker_id": "host",
          "scripts": [
            {
              "language": "en",
              "text": "We can reuse reviewed speech in different editions.",
              "sha256": "53e6307e1f044a160d0cdc774a406539aabd0622cd7c061ddab7f0e236106bcf",
              "authority": {
                "path": "fixture/fixture-text-authority-en",
                "sha256": "7b915ff6acd2bf3feff2b657bd465faaa2d868759d2399f11e07f346a756da2d",
                "bytes": 64
              },
              "id": "en-standard"
            },
            {
              "language": "es",
              "text": "Podemos reutilizar voz revisada en distintas ediciones.",
              "sha256": "86e2bd85cb47b16d83900de0f5681496ae35b48b052f4540e00b8a66b51ece91",
              "authority": {
                "path": "fixture/fixture-text-authority-es",
                "sha256": "8d66b3ae600992d9bb85d2c85a53a3b8906478ffb5dbc1e076983d493d212590",
                "bytes": 64
              },
              "id": "es-standard"
            }
          ]
        }
      ]
    },
    {
      "id": "detail",
      "requires": [],
      "cues": [
        {
          "id": "detail",
          "speaker_id": "expert",
          "scripts": [
            {
              "language": "en",
              "text": "Each edition selects exact takes and declares its speaker handoffs.",
              "sha256": "4339f736ca85bf46c328babaf7b993fb02ac9d6b384963511ff0d095279f918f",
              "authority": {
                "path": "fixture/fixture-text-authority-en",
                "sha256": "7b915ff6acd2bf3feff2b657bd465faaa2d868759d2399f11e07f346a756da2d",
                "bytes": 64
              },
              "id": "en-standard"
            },
            {
              "language": "es",
              "text": "Cada edición selecciona tomas exactas y declara los cambios de hablante.",
              "sha256": "ba6addb065d436903d96e9c663eae1b7d9d9fbbd72e875141202f1631cad3ece",
              "authority": {
                "path": "fixture/fixture-text-authority-es",
                "sha256": "8d66b3ae600992d9bb85d2c85a53a3b8906478ffb5dbc1e076983d493d212590",
                "bytes": 64
              },
              "id": "es-standard"
            }
          ]
        }
      ]
    },
    {
      "id": "closing",
      "requires": [
        "opening"
      ],
      "cues": [
        {
          "id": "closing",
          "speaker_id": "host",
          "scripts": [
            {
              "language": "en",
              "text": "The result keeps its own timing and review evidence.",
              "sha256": "df93872d5b4b16e045c8a549c29f9e19c28f10b6840782ebabb542a4ffbd3879",
              "authority": {
                "path": "fixture/fixture-text-authority-en",
                "sha256": "7b915ff6acd2bf3feff2b657bd465faaa2d868759d2399f11e07f346a756da2d",
                "bytes": 64
              },
              "id": "en-standard"
            },
            {
              "language": "es",
              "text": "El resultado conserva sus propios tiempos y la evidencia de revisión.",
              "sha256": "a56d760f3b789b5bc04bdcec22472b9c6e3bdafd92b7935465f41e3ed0ddff22",
              "authority": {
                "path": "fixture/fixture-text-authority-es",
                "sha256": "8d66b3ae600992d9bb85d2c85a53a3b8906478ffb5dbc1e076983d493d212590",
                "bytes": 64
              },
              "id": "es-standard"
            }
          ]
        }
      ]
    }
  ],
